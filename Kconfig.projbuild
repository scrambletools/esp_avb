menu "AVB Configuration"

    config ESP_AVB
        bool "Enable AVB"
        default y
        depends on ESP_PTP
        help
            Enable Audio Video Bridging (AVB) support.
            AVB provides time-synchronized, low-latency streaming services 
            through IEEE 802.1 standards. This option requires 
            PTP daemon (PTPD) for time synchronization.

    config ESP_AVB_DEBUG
        bool "Enable AVB debug messages"
        default n
        depends on DEBUG_INFO
        help
            Enable debug messages for AVB functionality.

    config ESP_AVB_STACKSIZE
        int "AVB stack size"
        default 6144 # DEFAULT_TASK_STACKSIZE
        depends on ESP_AVB
        help
            Set the stack size for the AVB task.

    config ESP_AVB_TASKPRIO
        int "AVB task priority"
        default 20
        depends on ESP_AVB
        help
            Set the priority for the AVB task.

    config ESP_AVB_STREAM_VLAN_ID_CLASS_A
        int "AVB Class A stream VLAN ID"
        default 2
        range 1 4094
        depends on ESP_AVB
        help
            VLAN ID for SR Class A streams (the default AVB VLAN).
            IEEE 802.1Q-2018 §35.2.2.8.2.3 Table 35-7 recommends VLAN 2
            for Class A. Many AVB switches (notably MOTU) enforce
            one-class-per-VLAN and rewrite the priority of any stream
            advertised with a different class on this VLAN.

    config ESP_AVB_STREAM_VLAN_ID_CLASS_B
        int "AVB Class B stream VLAN ID"
        default 2
        range 1 4094
        depends on ESP_AVB
        help
            VLAN ID for SR Class B streams. IEEE 802.1Q-2018 §35.2.2.8.2.3
            Table 35-7 places both SR classes on VLAN 2 by default —
            class is distinguished by PCP, not VID. Networks driven by
            the MOTU AVB switch and other strict implementations have
            been observed to advertise Class B Domain on VLAN 2, so
            the firmware must match to accept those declarations. May
            be overridden to a different VID for networks that segment
            classes by VLAN.

    config ESP_AVB_VLAN_PRIO_CLASS_A
        int "AVB Class A VLAN Priority"
        default 3
        range 0 7
        depends on ESP_AVB
        help
            Set VLAN Priority Code Point (PCP) for Class A streams.
            According to IEEE 802.1Q-2018:
            - PCP 3 is used for Credit-Based Shaper (CBS) traffic class A
            - Class A has more stringent latency requirements (2ms)

    config ESP_AVB_VLAN_PRIO_CLASS_B
        int "AVB Class B VLAN Priority"
        default 2
        range 0 7
        depends on ESP_AVB
        help
            Set VLAN Priority Code Point (PCP) for Class B streams.
            According to IEEE 802.1Q-2018:
            - PCP 2 is used for Credit-Based Shaper (CBS) traffic class B
            - Class B has less stringent latency requirements (50ms)

    config ESP_AVB_MILAN
        bool "Advertise AVnu Milan v1.3 compliance"
        default y
        depends on ESP_AVB
        help
            Advertise AVnu Milan v1.3 compliance by enabling Milan-specific
            discovery/control behavior, including MVU (Milan Vendor Unique)
            protocol support.

            The IEEE 1722 CRF media clock STREAM_INPUT and corresponding
            IEEE 1722.1 CLOCK_SOURCE of type INPUT_STREAM are supported as
            general AVB/AVDECC features regardless of this option. Disabling
            Milan does not remove CRF descriptors or clock-source descriptors;
            it only suppresses the device's Milan/MVU compliance advertisement.

            Enable this when interoperating with Milan-certified equipment
            or when using Milan-aware controllers (Hive).

            Disable this when you want the device to present itself as a
            pure IEEE 1722.1-2021 AVB/AVDECC endpoint rather than a
            Milan endpoint.

    config ESP_AVB_ATDECC
        bool "Build ATDECC (IEEE 1722.1) discovery + control"
        depends on ESP_AVB
        default n if ESP_AVB_ROLE_BRIDGE
        default y
        help
            Compile and link the ATDECC layer (atdecc.c) — ADP discovery,
            AECP entity model + control, ACMP stream connection management.
            When disabled, the AVTP RX dispatcher in avb.c silently drops
            ADP/AECP/ACMP subtypes and atdecc.c is excluded from the build.

            Default off for bridge builds (transparent L2 forwarder has no
            ATDECC entity); default on for endpoints.

    config ESP_AVB_WIFI_UNICAST_STREAMS
        bool "Deliver AVTP streams over Wi-Fi as unicast"
        default y
        help
            Re-address AVTP stream frames to an individual MAC for the
            Wi-Fi hop, restoring the original MAAP group address on the
            wired side. Affects both roles: a bridge rewrites the
            destination on Ethernet->Wi-Fi egress, and a Wi-Fi talker
            sends to the AP rather than to the group address.

            802.11 penalises group addressed frames heavily in BOTH
            directions. Downlink they are DTIM-buffered and, per
            IEEE 802.11 10.3.6, neither acknowledged nor retried.
            Uplink the penalty is an ESP-IDF driver limit rather than a
            standards one. Measured on this hardware with 234 B frames:

              downlink  multicast   397 pps  |  unicast  8342 pps
              uplink    multicast   322 pps  |  unicast  4777 pps

            A Milan AAF Class B stream needs 4000 pps, so group
            addressing cannot carry even one stream; unicast can.

            This is the same remedy every Wi-Fi vendor ships: hostapd
            multicast_to_unicast, Aruba DMO, Cisco Multicast Direct --
            and the problem is documented as inherent to 802.11 in
            RFC 9119. It is NOT IEEE 802.11 DMS: real DMS carries the
            group addressed MSDU inside an individually addressed
            A-MSDU and is negotiated with Action frames, neither of
            which ESP-IDF exposes. Call it DMS-equivalent behaviour.

            Stream identity and reservations are untouched: the AVTPDU
            stream_id is authoritative for the Listener (IEEE 1722
            4.4.4.8), and SRP/Milan keep seeing the MAAP address, which
            802.1Q 35.2.2.8.3 requires to be multicast or locally
            administered, a STA's globally administered factory MAC
            would not be a legal destination_address.

            Turn off to send streams over Wi-Fi exactly as received,
            which is standards-plain but ~20x slower.

    config ESP_AVB_WIFI_BUNDLE
        bool "Bundle stream frames on the Wi-Fi hop"
        depends on ESP_AVB_WIFI_UNICAST_STREAMS
        default n
        help
            Send several AVTPDUs of one stream in one Wi-Fi frame: the
            bridge toward a station and a station talker toward the
            bridge. Every 802.11 frame pays a fixed cost for contention,
            preamble and acknowledgment whatever its size, so 4000 small
            frames a second take most of the channel's airtime. The
            receiving end splits a bundle back into the original
            AVTPDUs, timestamps untouched; receiving is always enabled.

    config ESP_AVB_WIFI_BUNDLE_FRAMES
        int "Most AVTPDUs per Wi-Fi bundle"
        depends on ESP_AVB_WIFI_BUNDLE
        range 2 16
        default 8
        help
            A bundle also stops at 1500 bytes, so an 8-channel 48 kHz
            Class B stream fits 3 and a stereo one 11.

    config ESP_AVB_WIFI_BUNDLE_COMPACT
        bool "Compact bundles"
        depends on ESP_AVB_WIFI_BUNDLE
        default y
        help
            Send the AVTP header once per bundle and per frame only its
            sequence number and timestamp, and carry 32-bit AAF samples
            whose low octet is zero as 24 bits. Lossless: the receiver
            rebuilds the original AVTPDUs. An 8-channel stream then fits
            4 frames to a bundle instead of 3, and a stereo bundle of 8
            frames shrinks by about a third. Every receiver must run
            firmware that understands compact bundles.

    config ESP_AVB_WIFI_VIDEO_AC
        bool "Send Wi-Fi bundles as video traffic"
        depends on ESP_AVB_WIFI_BUNDLE
        default n
        help
            Send each bundle inside an IPv4 header with precedence 5, so
            the C6 transmits it in the video access category (TID 5)
            instead of best effort. Receivers accept both forms.

    config ESP_AVB_WIFI_VIDEO_AC_AB
        bool "Bench A/B: switch video traffic on and off every minute"
        depends on ESP_AVB_WIFI_BUNDLE
        default n
        help
            Logs "vi_ab: ab=N" every 10 s and switches the video access
            category every 60 s, for comparing both in the same air.

    config ESP_AVB_WIFI_RETX_HOLD_MAX_US
        int "Longest wait for a retransmitted Wi-Fi bundle (us)"
        default 40000
        range 1000 100000
        help
            A receiver that sees a gap in a stream's bundles holds the
            bundles after it and asks for the missing one. A station
            waits while its listener still plays audio queued before the
            gap, less 3 ms, and never longer than this. Each held bundle
            stays in RAM meanwhile, at most 32 per stream.

    config ESP_AVB_WIFI_RETX_DOWNSTREAM_LATENCY_US
        int "Playout latency assumed behind the bridge for uplink gaps (us)"
        default 0
        range 0 100000
        depends on ESP_AVB_ROLE_BRIDGE
        help
            The bridge has no listener of its own, so it waits for a
            station's missing uplink bundle only until the earliest held
            frame's presentation time plus this, less 3 ms. With 0 it
            waits at most 1 ms past presentation time and, as station
            talkers arrive after it, sends no NACKs. Set it to a value the
            wired listeners' playout latency covers to trade uplink
            latency for recovery.

    config ESP_AVB_WIFI_DELIVERABLE_FRAMES
        int "Wi-Fi port deliverable frames a second"
        default 6000
        range 1000 30000
        depends on ESP_AVB_ROLE_BRIDGE && ESP_AVB_WIFI_UNICAST_STREAMS
        help
            Individually addressed frames a second the bridge delivers
            in its BSS. Its frame budget is 75 % of this, the rest left
            to best effort (profiles/avb_wireless.md section 4): a
            stream whose first listener station would take the admitted
            streams past the budget, or past 75 % of the link rate,
            gets Talker Failed with insufficient_bandwidth. Class A is
            admitted toward the Wi-Fi port only from 12000 frames a
            second, and only with allow_class_a_over_wifi set.

            Offered a single 8000 frame/s stream, an ESP32-P4 bridge
            with an ESP32-C6 coprocessor over SDIO delivered about 6100
            frames a second to its station, so the default gives a
            budget of 4500: one 4000 frame/s Class B stream fits.

    config ESP_AVB_AVB_LITE_COMPLIANT
        bool "Advertise AVB Lite compliance"
        default y
        depends on ESP_AVB
        help
            Allow ESP-AVB to advertise/report AVB Lite operation when the PTP
            daemon falls back from gPTP to the standard PTP profile. If this is
            disabled, ESP-AVB will not switch its public AVB Lite status on even
            if PTP is running in standard profile.

    config ESP_AVB_SUPERFAST_CONNECT
        bool "Superfast connect: provisional playout from NVS binding"
        default y
        depends on ESP_AVB && !ESP_AVB_DISABLE_FAST_CONNECT
        help
            Start listener stream RX and playout immediately after NVS
            restores a saved binding — before gPTP lock, MSRP/CVU
            declarations, or ACMP fast-connect complete. The expected
            stream_id is derived from the persisted talker identity;
            playout opens on the prefill gate and moves onto
            presentation time once PTP locks. Works in AVB Lite and
            plain AVB. Default y: cuts boot-to-audio from ~9 s to
            ~3.5 s. Playout before the handshakes finish is not
            Milan-conformant, so disable this for strict Milan
            certification; the normal fast-connect and declaration
            machinery still runs and takes over with authoritative
            parameters. If the talker is not currently transmitting to
            this listener, the early start idles harmlessly. Requires
            fast-connect: a provisional start is a guess that only the
            ACMP handshake can confirm or correct.

    config ESP_AVB_LITE_UNICAST_FANOUT
        int "AVB Lite unicast stream fan-out limit"
        default 2
        range 1 8
        depends on ESP_AVB_AVB_LITE_COMPLIANT
        help
            Maximum number of listeners served with per-listener unicast
            copies of each stream in AVB Lite mode (avb_lite.md,
            "Stream transport addressing"). Non-AVB switches flood
            multicast streams to every port, so AVB Lite talkers default
            to one unicast copy per listener. Beyond this many listeners
            the talker escalates the stream to its MAAP multicast
            address where a controller allowed escalation with
            SET_LITE_CONFIG (off by default), and otherwise refuses each
            further listener with a unicast Talker Failed, failure code
            2. Each copy costs egress bandwidth and TX CPU.

    config ESP_AVB_LITE_ESCALATION_ALLOWED
        bool "AVB Lite: allow multicast escalation by default"
        default n
        depends on ESP_AVB_AVB_LITE_COMPLIANT
        help
            Lets talkers escalate a stream to its multicast address
            beyond the unicast fan-out limit before any controller has
            configured the interface (avb_lite.md section 2.4). A
            controller's SET_LITE_CONFIG, persisted in NVS, overrides
            it. A non-AVB switch floods an escalated stream to every
            port in the domain, so allow it only where the media VLAN
            is confined.

    config ESP_AVB_LITE_MEDIA_VLAN_ID
        int "AVB Lite media VLAN ID"
        default 2
        range 0 4094
        depends on ESP_AVB_AVB_LITE_COMPLIANT
        help
            VLAN that AVB Lite media streams and CVU SRP messages are
            tagged in, at 802.1p priority 5 (avb_lite.md section 7).
            Every AVB Lite device in a system uses the same one. 2, as
            in AVB, passes unmanaged switches unchanged but needs VLAN 2
            on the media ports of managed switches. 0 sends a priority
            tag only, which works on any switch without VLAN
            configuration but shares the untagged VLAN with other
            traffic.

    config ESP_AVB_AM824_CIP_SYT
        bool "Stamp CIP SYT field in AM824 packets"
        default n
        depends on ESP_AVB
        help
            Populate the IEC 61883 CIP SYT field with the FireWire-style
            cycle timestamp (4-bit cycle count, 12-bit cycle offset in
            1/3072-cycle ticks) of the same instant the avtp_timestamp
            refers to, instead of SYT=0xFFFF (NO_INFO). IEEE 1722-2016
            carries presentation time in avtp_timestamp and expects SYT
            unused, but some FireWire-heritage listeners (MOTU observed)
            recover their media clock only from SYT when clocked from an
            input stream. Note the SYT cycle window is 16 x 125 us = 2 ms,
            so listeners relying on it typically need a presentation
            offset under ~2 ms to disambiguate. Off by default.

    config ESP_AVB_TALKER_TEST_TONE
        bool "Talker test tone (sine) instead of codec input"
        default n
        depends on ESP_AVB
        help
            Stream a generated sine wave on the talker audio output
            instead of reading the codec ADC. Proves the talker ->
            listener path end to end independent of the analog input
            chain (source level, PGA gain, input routing). Roughly
            -23 dBFS on every channel.

    config ESP_AVB_TALKER_TEST_TONE_HZ
        int "Test tone frequency (Hz)"
        default 1000
        range 20 20000
        depends on ESP_AVB_TALKER_TEST_TONE
        help
            Frequency of the generated test tone.

    config ESP_AVB_TEST_TONE_PER_CHANNEL
        bool "Test tone at a different frequency on each channel"
        default n
        depends on ESP_AVB
        help
            Channel n plays the test tone frequency plus 250 Hz x n
            (1000, 1250, 1500 Hz and so on for a 1 kHz tone), so a
            capture shows channel order as well as clicks, gaps and
            rate. Applies to the test tone build and to the Test Tone
            control.

    config ESP_AVB_LISTENER_MIRROR
        bool "Talker carries the listener's playout (test builds)"
        default n
        depends on ESP_AVB
        help
            For test builds. The talker sends the exact samples the
            listener hands the codec in place of the codec input: the
            DAC's left and right on channels 0 and 1, silence on the
            other channels and while the listener is idle. A capture of
            the talker stream then checks the listener's output bit for
            bit with no analog wiring. The Test Tone control still
            replaces it, and codec volume applies after these samples.
            The codec input is not streamed in this build.

    config ESP_AVB_DEFAULT_FORMAT_AM824
        bool "Default stream format AM824 (IEC 61883-6) instead of AAF"
        default n
        depends on ESP_AVB
        help
            Build the default audio stream format as AM824 (IEC
            61883-6, label + 24-bit MBLA samples) instead of AAF PCM.
            For interop with listeners whose stream inputs default to
            AM824 and that apply no format check on connect (MOTU 8D
            observed: an AAF payload decoded as AM824 discards the top
            sample byte and plays sample<<8 with wraparound — a harsh
            odd-harmonic staircase). A controller that sets formats
            explicitly on both ends makes this option irrelevant.

    config ESP_AVB_TALKER_MIC_DIGITAL_GAIN_DB
        int "Talker mic digital gain (dB)"
        default 0
        range 0 40
        depends on ESP_AVB
        help
            Digital gain applied to the mic input in the talker path,
            after an always-on DC-block. For microphones whose level
            the codec PGA cannot reach (e.g. a dynamic mic on the
            ES8389, PGA ceiling +36.5 dB). 0 = unity. Applied with
            24-bit saturation.

    config ESP_AVB_TALKER_CADENCE_LOCK_INTERVAL_S
        int "Talker cadence rate-lock interval (s, 0 = free-run)"
        default 60
        range 0 3600
        depends on ESP_AVB
        help
            Rate-lock the audio talker's packet cadence to gPTP by
            measuring the gPTP-vs-local-timer offset over windows of
            this many seconds, so long-run sample count tracks the
            gPTP domain (no cumulative listener drop/dup). The slip
            measurement carries a roughly fixed few-µs noise per
            sample, so longer windows inject proportionally less rate
            wander into packet spacing (1 s windows measured ±12 ppm
            wander at the wire; 60 s reduces the same noise to
            ±0.05 ppm). Corrections are additionally clamped to
            ±1 ppm per update. A short warmup window trims the static
            crystal offset within seconds of stream start.

            Set to 0 to free-run: cadence is paced purely by the local
            timer with only the initial media timestamp seeded from
            gPTP — no gPTP feedback into packet spacing, at the cost
            of unbounded slow timestamp drift at crystal-offset rate.
            Use 0 to diagnose listener-side artifacts attributed to
            cadence modulation, or when an external media-clock chain
            cannot tolerate any talker-side rate steering.

    config ESP_AVB_TALKER_RESAMPLE
        bool "Resample the codec input to the stream rate"
        default y
        depends on ESP_AVB && !SOC_CLK_APLL_SUPPORTED
        help
            Without an APLL the codec clock cannot be trimmed to gPTP,
            so its frames arrive at the crystal's rate. With this on,
            the talker converts them to the stream's nominal rate
            (16-tap polyphase, flat within 0.1 dB to 15 kHz) and the
            stream's samples match its timestamps exactly. Off, the
            packet cadence follows the codec instead, and listeners
            that hold their own clock trim or slip to keep up.

    config ESP_AVB_STATION_TALKER_BATCHED
        bool "Single-core talker sends in timed batches"
        default y
        depends on ESP_AVB && FREERTOS_UNICORE
        help
            On a single-core chip the talker cannot spin on its own core
            until each packet's slot. Without this option it spins at a
            low priority and yields, so every higher-priority task holds
            it off and it sends what it missed in a burst afterwards.
            With it, the talker blocks, a GPTimer alarm wakes it when the
            packet that fills a Wi-Fi bundle (ESP_AVB_WIFI_BUNDLE_FRAMES)
            is due, and it sends what is due, each packet stamped for its
            own slot, at a priority just below the Wi-Fi and AVB protocol
            tasks. A packet leaves up to a bundle's frames, less one,
            after its slot, about as long as it waited in the bundle
            before. Applies to the codec input; the test tone keeps the
            spin.

    config ESP_AVB_STATION_TALKER_PRIORITY
        int "Single-core talker task priority while batched"
        default 19
        range 3 23
        depends on ESP_AVB_STATION_TALKER_BATCHED
        help
            Below the Wi-Fi task, PTPD, the AVB task and the system event
            task, above lwIP's tcpip task.

    config ESP_AVB_STATION_RX_WORKER
        bool "Station handles received frames in a worker task"
        default y
        depends on ESP_AVB && FREERTOS_UNICORE && !ESP_AVB_ROLE_BRIDGE
        help
            Hand received frames from the Wi-Fi task to a worker below the
            talker instead of handling them in the Wi-Fi task, where
            unpacking a burst of stream bundles held a single-core
            station's talker off for milliseconds. The listener's buffer
            absorbs the wait. A full queue drops the frame (STREAM
            rx_drops=).

    config ESP_AVB_STATION_RX_WORKER_PRIORITY
        int "Station receive worker priority"
        default 18
        range 2 22
        depends on ESP_AVB_STATION_RX_WORKER
        help
            Below the batched talker (ESP_AVB_STATION_TALKER_PRIORITY).

    config ESP_AVB_LISTENER_CONCEAL_REPEAT
        bool "Conceal lost audio by repeating the waveform"
        default n
        help
            Fill a gap with the last pitch period of the audio before it,
            fading to silence over 20 ms, and crossfade into the audio
            after it over 1 ms, instead of inserting silence.

    config ESP_AVB_LISTENER_CONCEAL_AB
        bool "Bench A/B: switch concealment every minute"
        default n
        help
            Switches between silence and waveform repetition every 60 s
            and logs "CONCEAL: ab=N" with the mean sample step into and
            out of each insert.

    config ESP_AVB_LISTENER_EXTRA_LATENCY_US
        int "Listener playout latency added beyond presentation time (µs)"
        default 0
        range 0 40000
        depends on ESP_AVB
        help
            The listener starts playout when gPTP reaches the stream's
            AVTP presentation timestamp plus this offset (minus the
            fixed output-pipeline delay). The default 0 plays exactly
            at the talker's intended presentation time — sync-accurate
            with third-party listeners. The media-clock loop measures
            the local playout rate from the I2S DMA completion
            callback, so clock recovery works at any fill; the cost of
            0 is cushion: the standing buffer is only the talker's
            transit margin (typically ~2 ms), so scheduling stalls
            longer than that produce a brief dropout followed by an
            automatic presentation-time resync. Raise this on
            deployments that prefer stall immunity over strict sync;
            all listeners configured with the same value still play in
            sample-accurate sync with each other. When stream
            timestamps are flagged uncertain (tu=1) or gPTP is not yet
            valid, playout falls back to a fixed byte-prefill gate.

    config ESP_AVB_LISTENER_EXTRA_LATENCY_WIFI_US
        int "Further playout latency on a Wi-Fi station (µs)"
        default 30000
        range 0 60000
        depends on ESP_AVB
        help
            Added to the extra latency above when the listener is a
            Wi-Fi station. The downlink stalls for 20 to 50 ms at times,
            longer than a talker's usual presentation offset, and each
            stall the buffer cannot cover is a dropout that also moves
            playout later. A station then plays this much after wired
            listeners of the same stream.

    config ESP_AVB_TALKER_NEW_STREAM_ID_ON_GROW
        bool "Give a grown Stream Output a new stream ID"
        default y
        depends on ESP_AVB
        help
            A format change that grows a Stream Output's reservation
            (more channels, a higher rate or another class) moves the
            stream to the next of four stream IDs, which differ in the
            top two bits of the last octet, and declares it at once. A
            bridge has no reservation for the new ID, so the stream
            starts with its connect. Under the same ID the talker must
            first leave the stream undeclared for two LeaveAll periods
            (802.1Q 35.2.2.8), 13 to 23 s on a MOTU switch. The ID
            changes only while the stream is stopped and no other
            listener is connected to it; controllers see the new ID in
            GET_STREAM_INFO. Shrinks keep the ID.

    config ESP_AVB_TALKER_MIN_OFFSET_WIFI_US
        int "Least presentation offset of a Wi-Fi station's talker (µs)"
        default 30000
        range 0 50000
        depends on ESP_AVB
        help
            A Wi-Fi station's Stream Output presents its samples at
            least this long after capture, whatever max transit time a
            controller set (a larger one still applies), and reports
            the offset it uses. The uplink stalls for 20 to 50 ms at
            times, and the station's gPTP time runs milliseconds off
            the bridge's: with the 12 ms default, frames reached a
            wired listener a median 5.7 ms before their presentation
            time and some arrived late. Class B allows 50 ms.

    config ESP_AVB_STATION_CHANNELS_PER_STREAM
        int "Channels per stream on a Wi-Fi station"
        default 2
        range 1 8
        depends on ESP_AVB
        help
            A Wi-Fi station's stream formats carry at most this many
            channels, in both directions. Its codec is stereo, and an
            8-channel Class B stream costs four times the airtime: a C6
            station measured 12 % of its 8-channel uplink sends failing
            for buffers and nearly half of its frames lost, with
            2-channel streams clean. Wired endpoints are unaffected.

    config ESP_AVB_LISTENER_LATENCY_TRIM_S
        int "Trim surplus playout latency every this many seconds (0 = never)"
        default 60
        range 0 3600
        depends on ESP_AVB
        help
            Audio that arrives after its presentation time leaves the
            DAC playing silence, and playout continues that much later
            so the next equally late arrival still plays. When a whole
            window of this length then passed with more audio buffered
            at every moment than the latency needed (plus a 3 ms
            margin), the listener drops the surplus in one skip, never
            below presentation time. Latency then follows the worst
            lateness of the recent window instead of the worst ever,
            which also undoes a playout start that locked late. 0 keeps
            any latency once taken. A station uses
            ESP_AVB_LISTENER_LATENCY_TRIM_WIFI_S instead.

    config ESP_AVB_LISTENER_LATENCY_TRIM_WIFI_S
        int "Latency trim window on a Wi-Fi listener (s, 0 = never)"
        default 60
        range 0 3600
        depends on ESP_AVB
        help
            ESP_AVB_LISTENER_LATENCY_TRIM_S for a station. A trim never
            reaches into ESP_AVB_LISTENER_EXTRA_LATENCY_WIFI_US, which
            covers the downlink's usual stalls, so this only bounds how
            long an outage's added latency stays: measured 16 ms after a
            bridge reset. Without the cushion a 60 s window trimmed away
            the latency one stall had added just before the next stall,
            which then played silence again; there, use a window longer
            than the stalls' spacing (600 s).

    config ESP_AVB_AUTO_CRF_CLOCK_SOURCE
        bool "Auto-select CRF input as media clock source when live"
        default y
        depends on ESP_AVB
        help
            Follow CRF stream liveness automatically: when a connected
            CRF input stream is delivering fresh timestamps, switch the
            media clock source to CRF INPUT; when the CRF reference
            goes stale, revert to INTERNAL (gPTP). The CRF reference
            pairs the talker's media clock directly against the local
            DAC byte counter, keeping local PTP servo phase noise out
            of the clock-recovery measurement entirely — measurably
            smoother than the gPTP-referenced path. A controller's
            SET_CLOCK_SOURCE is still accepted, but a subsequent CRF
            liveness change overrides it; disable this option for
            strictly controller-managed clock domains.

    config ESP_AVB_PLL_MAX_PPM
        int "Media-clock PLL maximum applied correction (ppm)"
        default 150
        range 50 300
        depends on ESP_AVB
        help
            Safety clamp on the total media-clock correction the PLL
            may apply. Must exceed the worst LEGAL talker media-clock
            tolerance (IEEE 1722 allows +/-100 ppm) PLUS this device's
            own crystal offset: a listener tracks the sum of both, so
            a 100 ppm clamp rails against a spec-legal talker at the
            edge (observed: 6 h pinned at +100 ppm on the PreSonus
            bench behind a free-running talker). Corrections beyond
            the clamp are treated as measurement error.

    config ESP_AVB_STATS_CPU_TABLE
        bool "Print the per-task CPU table every stats window"
        default n
        depends on ESP_AVB
        help
            Diagnostic builds. Every 10 s the AVB-STATS task logs each
            task's CPU share, priority, core and stack high water mark,
            plus per-core busy time. The task snapshot suspends the
            scheduler for a few milliseconds, which a bridge forwarding
            a Class B stream cannot afford.

    config ESP_AVB_PLL_APLL_FINE_SET
        bool "Retune the APLL by its fractional registers only"
        default y
        depends on ESP_AVB
        help
            Media-clock corrections rewrite only the APLL's fractional
            sigma-delta registers that changed, with the modulator left
            running and the output divider untouched. The full sequence
            (clk_ll_apll_set_config) pulses SDM_STOP and reloads the
            divider on every correction, which on the P4 can glitch
            MCLK and make the codec drop a sample. Measured 2026-10-26:
            three of four full-sequence retunes put a phase step on the
            DAC output, none of four fine retunes did, and the fine
            retune still moved the output frequency.

    config ESP_AVB_PLL_CORRECTION_INTERVAL_S
        int "Listener media-clock correction interval (s, 0 = fixed clock)"
        default 30
        range 0 600
        depends on ESP_AVB
        help
            How often the listener media-clock recovery loop folds the
            measured byte-rate-vs-reference error into an MCLK (APLL)
            correction target. The target is never applied as a step:
            the applied value slews toward it at a bounded rate
            (~0.1 ppm/s), because instantaneous MCLK steps — even
            ~1 ppm — can be audible through some codecs' clocking,
            while slow continuous drift far below the pitch JND is not.

            Set to 0 to never retune MCLK (fixed media clock). The
            loop keeps measuring and reporting drift for diagnostics;
            the jitter buffer then absorbs rate mismatch until it
            drops/dups. Use 0 for codecs that audibly react to any
            MCLK coefficient change, or to isolate the recovery loop
            while diagnosing audio artifacts.

    config ESP_AVB_TALKER_SLIP_MUTE
        bool "Mute the talker when a capture slot slip is detected"
        default y
        depends on ESP_AVB
        help
            The ESP32-P4 full-duplex RX path can, after a rate change, go
            through seconds-long episodes in which short runs of capture
            frames are replaced by data from elsewhere (heard as a dense
            crackle). The guard watches the jump density of the captured
            signal (large sample-to-sample steps against its running mean)
            and, on a burst of three pulses in 64 ms, mutes the talker until
            500 ms pass without another burst, then fades back in over 1 ms.
            STREAM-OUT reports slips=<detections>/<packets muted>.

    config ESP_AVB_LISTENER_STREAM_CLOCK_RECOVERY
        bool "Listener recovers its media clock from the audio stream"
        default y
        depends on ESP_AVB
        help
            With no CRF stream connected, steer the listener MCLK so the
            DAC consumes exactly what the audio stream delivers (jitter
            ring fill held constant) instead of disciplining it to local
            gPTP time. Any talker media-clock rate is followed and the
            local gPTP servo's phase noise stays out of the loop. The
            clock source is still reported as INTERNAL. Disable to use
            the gPTP (INTERNAL) reference as before.

    # ----------------------------------------------------------------
    # Per-port topology — derived from esp_ptp's taxonomy.
    #
    # esp_ptp owns the user-facing per-port configuration because gPTP
    # is mandatory for AVB and every AVB port is a gPTP port (IEEE
    # 802.1AS clause 12). The ESP_AVB_* port symbols below are mirrors
    # that auto-track ESP_PTP_* selections so the two components cannot
    # drift.
    #
    # Five orthogonal per-port knobs (see esp_ptp Kconfig for details):
    #   MEDIUM     ethernet | wifi
    #   HOST_IF    emac | ahb | sdio | spi | usb | other
    #   TYPE       primary | failover | bridged
    #   WIFI_MODE  ap | sta            (only when MEDIUM=wifi)
    #   LINK_SPEED_MBPS                (nominal PHY-rate cap)
    #
    # Mapping rules:
    #   ESP_AVB_NUM_PORTS                ← ESP_PTP_NUM_PORTS
    #   ESP_AVB_PORTn_MEDIUM_*           ← ESP_PTP_PORTn_MEDIUM_*
    #   ESP_AVB_PORTn_HOST_IF_*          ← ESP_PTP_PORTn_HOST_IF_*
    #   ESP_AVB_PORTn_TYPE_*             ← ESP_PTP_PORTn_TYPE_*
    #   ESP_AVB_PORTn_WIFI_MODE_*        ← ESP_PTP_PORTn_WIFI_MODE_*
    #   ESP_AVB_PORTn_LINK_SPEED_MBPS    ← ESP_PTP_PORTn_LINK_SPEED_MBPS
    #   ESP_AVB_PORTn_TIME_SOURCE_GPTP_WIRED      ← MEDIUM=ethernet
    #   ESP_AVB_PORTn_TIME_SOURCE_BEACON_IE_WIFI  ← MEDIUM=wifi
    #   ESP_AVB_ROLE_BRIDGE              ← any port has TYPE_BRIDGED
    #   ESP_AVB_ROLE_ENDPOINT_WIRELESS   ← port0 PRIMARY + WIFI + STA
    #   ESP_AVB_ROLE_ENDPOINT_WIRED      ← port0 PRIMARY + ETHERNET
    #
    # To change topology, edit ESP_PTP_* under "PTP Daemon Configuration".
    # ----------------------------------------------------------------

    config ESP_AVB_NUM_PORTS
        int
        default ESP_PTP_NUM_PORTS
        depends on ESP_AVB

    # ----- Port 0 -----

    config ESP_AVB_PORT0_MEDIUM_ETH_HWTS
        bool
        default y if ESP_PTP_PORT0_MEDIUM_ETH_HWTS
        depends on ESP_AVB

    config ESP_AVB_PORT0_MEDIUM_WIFI_FTM
        bool
        default y if ESP_PTP_PORT0_MEDIUM_WIFI_FTM
        depends on ESP_AVB

    config ESP_AVB_PORT0_HOST_IF_EMAC
        bool
        default y if ESP_PTP_PORT0_HOST_IF_EMAC
        depends on ESP_AVB

    config ESP_AVB_PORT0_HOST_IF_AHB
        bool
        default y if ESP_PTP_PORT0_HOST_IF_AHB
        depends on ESP_AVB

    config ESP_AVB_PORT0_HOST_IF_SDIO
        bool
        default y if ESP_PTP_PORT0_HOST_IF_SDIO
        depends on ESP_AVB

    config ESP_AVB_PORT0_HOST_IF_SPI
        bool
        default y if ESP_PTP_PORT0_HOST_IF_SPI
        depends on ESP_AVB

    config ESP_AVB_PORT0_HOST_IF_USB
        bool
        default y if ESP_PTP_PORT0_HOST_IF_USB
        depends on ESP_AVB

    config ESP_AVB_PORT0_HOST_IF_OTHER
        bool
        default y if ESP_PTP_PORT0_HOST_IF_OTHER
        depends on ESP_AVB

    config ESP_AVB_PORT0_TYPE_PRIMARY
        bool
        default y if ESP_PTP_PORT0_TYPE_PRIMARY
        depends on ESP_AVB

    config ESP_AVB_PORT0_TYPE_FAILOVER
        bool
        default y if ESP_PTP_PORT0_TYPE_FAILOVER
        depends on ESP_AVB

    config ESP_AVB_PORT0_TYPE_BRIDGED
        bool
        default y if ESP_PTP_PORT0_TYPE_BRIDGED
        depends on ESP_AVB

    config ESP_AVB_PORT0_WIFI_MODE_AP
        bool
        default y if ESP_PTP_PORT0_WIFI_MODE_AP
        depends on ESP_AVB

    config ESP_AVB_PORT0_WIFI_MODE_STA
        bool
        default y if ESP_PTP_PORT0_WIFI_MODE_STA
        depends on ESP_AVB

    config ESP_AVB_PORT0_LINK_SPEED_MBPS
        int
        default ESP_PTP_PORT0_LINK_SPEED_MBPS
        depends on ESP_AVB

    config ESP_AVB_PORT0_TIME_SOURCE_GPTP_WIRED
        bool
        default y if ESP_PTP_PORT0_MEDIUM_ETH_HWTS
        depends on ESP_AVB

    config ESP_AVB_PORT0_TIME_SOURCE_BEACON_IE_WIFI
        bool
        default y if ESP_PTP_PORT0_MEDIUM_WIFI_FTM
        depends on ESP_AVB

    # ----- Port 1 -----

    config ESP_AVB_PORT1_MEDIUM_ETH_HWTS
        bool
        default y if ESP_PTP_PORT1_MEDIUM_ETH_HWTS
        depends on ESP_AVB && ESP_PTP_NUM_PORTS = 2

    config ESP_AVB_PORT1_MEDIUM_WIFI_FTM
        bool
        default y if ESP_PTP_PORT1_MEDIUM_WIFI_FTM
        depends on ESP_AVB && ESP_PTP_NUM_PORTS = 2

    config ESP_AVB_PORT1_HOST_IF_EMAC
        bool
        default y if ESP_PTP_PORT1_HOST_IF_EMAC
        depends on ESP_AVB && ESP_PTP_NUM_PORTS = 2

    config ESP_AVB_PORT1_HOST_IF_AHB
        bool
        default y if ESP_PTP_PORT1_HOST_IF_AHB
        depends on ESP_AVB && ESP_PTP_NUM_PORTS = 2

    config ESP_AVB_PORT1_HOST_IF_SDIO
        bool
        default y if ESP_PTP_PORT1_HOST_IF_SDIO
        depends on ESP_AVB && ESP_PTP_NUM_PORTS = 2

    config ESP_AVB_PORT1_HOST_IF_SPI
        bool
        default y if ESP_PTP_PORT1_HOST_IF_SPI
        depends on ESP_AVB && ESP_PTP_NUM_PORTS = 2

    config ESP_AVB_PORT1_HOST_IF_USB
        bool
        default y if ESP_PTP_PORT1_HOST_IF_USB
        depends on ESP_AVB && ESP_PTP_NUM_PORTS = 2

    config ESP_AVB_PORT1_HOST_IF_OTHER
        bool
        default y if ESP_PTP_PORT1_HOST_IF_OTHER
        depends on ESP_AVB && ESP_PTP_NUM_PORTS = 2

    config ESP_AVB_PORT1_TYPE_PRIMARY
        bool
        default y if ESP_PTP_PORT1_TYPE_PRIMARY
        depends on ESP_AVB && ESP_PTP_NUM_PORTS = 2

    config ESP_AVB_PORT1_TYPE_FAILOVER
        bool
        default y if ESP_PTP_PORT1_TYPE_FAILOVER
        depends on ESP_AVB && ESP_PTP_NUM_PORTS = 2

    config ESP_AVB_PORT1_TYPE_BRIDGED
        bool
        default y if ESP_PTP_PORT1_TYPE_BRIDGED
        depends on ESP_AVB && ESP_PTP_NUM_PORTS = 2

    config ESP_AVB_PORT1_WIFI_MODE_AP
        bool
        default y if ESP_PTP_PORT1_WIFI_MODE_AP
        depends on ESP_AVB && ESP_PTP_NUM_PORTS = 2

    config ESP_AVB_PORT1_WIFI_MODE_STA
        bool
        default y if ESP_PTP_PORT1_WIFI_MODE_STA
        depends on ESP_AVB && ESP_PTP_NUM_PORTS = 2

    config ESP_AVB_PORT1_LINK_SPEED_MBPS
        int
        default ESP_PTP_PORT1_LINK_SPEED_MBPS
        depends on ESP_AVB && ESP_PTP_NUM_PORTS = 2

    config ESP_AVB_PORT1_TIME_SOURCE_GPTP_WIRED
        bool
        default y if ESP_PTP_PORT1_MEDIUM_ETH_HWTS
        depends on ESP_AVB && ESP_PTP_NUM_PORTS = 2

    config ESP_AVB_PORT1_TIME_SOURCE_BEACON_IE_WIFI
        bool
        default y if ESP_PTP_PORT1_MEDIUM_WIFI_FTM
        depends on ESP_AVB && ESP_PTP_NUM_PORTS = 2

    config ESP_AVB_ROLE_BRIDGE
        bool
        default y if ESP_PTP_PORT0_TYPE_BRIDGED || ESP_PTP_PORT1_TYPE_BRIDGED
        depends on ESP_AVB

    config ESP_AVB_ROLE_ENDPOINT_WIRELESS
        bool
        default y if ESP_PTP_PORT0_TYPE_PRIMARY && ESP_PTP_PORT0_MEDIUM_WIFI_FTM && ESP_PTP_PORT0_WIFI_MODE_STA
        depends on ESP_AVB && !ESP_AVB_ROLE_BRIDGE

    config ESP_AVB_ROLE_ENDPOINT_WIRED
        bool
        default y if ESP_PTP_PORT0_TYPE_PRIMARY && ESP_PTP_PORT0_MEDIUM_ETH_HWTS
        depends on ESP_AVB && !ESP_AVB_ROLE_BRIDGE && !ESP_AVB_ROLE_ENDPOINT_WIRELESS

    config ESP_AVB_FTM_IE_HOOK
        bool "Use FTM-frame Vendor IE for FollowUpInformation transport"
        default n
        depends on ESP_AVB
        help
            Standards-track migration boundary. Default n routes
            FollowUpInformation through the AP's beacon Vendor IE (the only
            carrier reachable through the public ESP-IDF Wi-Fi API). When
            Espressif exposes an FTM-frame Vendor IE injection hook, set
            this to y and the same FollowUpInformation byte format will
            ride the FTM action frame as IEEE 802.1AS-2020 §12.7
            prescribes. Reserved for future; not implemented in this build.

    config ESP_AVB_DISABLE_FAST_CONNECT
        bool "Disable listener fast-connect (test builds only)"
        default n
        depends on ESP_AVB
        help
            Skip the per-tick avb_periodic_fast_connect retry loop on the
            listener side. Intended for test builds where a controller-driven
            CONNECT is fighting the listener's own NVS-restored binding —
            specifically the Phase 3 class-selection demo where fast-connect
            re-binds with default (Class A) flags within milliseconds of
            controller-initiated disconnect, preventing observation of a
            clean Class B path. Keep default n in production builds.

endmenu # ESP_AVB Configuration
